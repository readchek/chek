// The contract between the Chek server and a source extension.
//
// An extension is a WebAssembly component that targets the `source` world. It
// runs with an empty WASI environment: no files, no environment variables, no
// sockets and no clock beyond what WASI always gives. The only way out is the
// host interfaces, and the server lets HTTP requests reach only the sites the
// extension's manifest declares.
//
// Every call starts from a fresh instance, so memory doesn't carry over
// between calls. What should carry over goes through the server instead:
// `cache` keeps values, a request can ask for its response to be cached, and
// `cookies` holds a jar the server sends and fills on every request, as a
// browser would. All three are kept per extension id and sites, across
// versions and restarts, and none is available while the manifest is read.
package chek:source@0.6.0;

interface types {
    type header = tuple<string, string>;

    // An image the server fetches itself, such as a cover or a page. The
    // server sends the headers as given and checks the URL against the
    // manifest's sites like any other request.
    record image {
        url: string,
        headers: list<header>,
        // Source-defined transform parameters, included in the image cache
        // key. None keeps the ordinary fetch path without calling the hook.
        transform: option<string>,
    }

    record image-data {
        content-type: string,
        body: list<u8>,
    }

    enum reading-direction {
        ltr,
        rtl,
        ttb,
    }

    record manifest {
        // Stable and unique across repositories, in reverse-DNS form such
        // as `org.example.comics`.
        id: string,
        name: string,
        version: string,
        // Hosts the extension may reach, such as `api.example.org`, or
        // `*.example.org` for any subdomain of example.org. Requests use
        // HTTPS only.
        sites: list<string>,
        // BCP 47 tags of the languages the source serves, empty if any.
        languages: list<string>,
        // What the extension needs beyond plain requests. The repository's
        // index must list the same.
        capabilities: list<capability>,
    }

    enum capability {
        // A real browser, through the solver service the server's admin
        // runs. Requests that meet a Cloudflare challenge are passed to it
        // and retried with the cookies and user agent it earned, and the
        // `browser` interface loads pages in it directly. Without a
        // solver, challenges come back as the site sent them.
        browser,
        // A private interactive browser during one export call.
        browser-session,
        // May transform fetched images and use the image operations below.
        image-transform,
    }

    // How explicit a series is, on the scale MangaDex uses. Readers choose
    // which ratings they see; `search` is given that choice, and the server
    // also drops results rated outside it.
    enum content-rating {
        // Fit for everyone.
        safe,
        // Fan service, revealing outfits or mild sexual themes.
        suggestive,
        // Nudity or sexual content short of explicit.
        erotica,
        // Explicit sexual content.
        pornographic,
    }

    record series-item {
        // The source's own id, stored as the series' remote id.
        id: string,
        title: string,
        cover: option<image>,
        // As the source rates it, when it does.
        content-rating: option<content-rating>,
    }

    record series-page {
        items: list<series-item>,
        has-more: bool,
    }

    record contributor {
        name: string,
        // A Readium contributor role, such as `author` or `artist`.
        role: string,
    }

    // Whether a series is still going, as the source says.
    enum status {
        ongoing,
        completed,
        // Paused by its author or publisher, expected to resume.
        hiatus,
        cancelled,
    }

    record series {
        id: string,
        title: string,
        summary: option<string>,
        cover: option<image>,
        contributors: list<contributor>,
        reading-direction: option<reading-direction>,
        status: option<status>,
        // The year it started, when the source knows.
        year: option<u16>,
        // Genres and themes as the source names them, in reading order of
        // importance, such as `Action` or `Slice of Life`. Empty if none.
        tags: list<string>,
        // As the source rates it, when it does.
        content-rating: option<content-rating>,
    }

    record chapter {
        // The source's own id, stored as the content's remote id.
        id: string,
        title: string,
        // The chapter or volume number as the source writes it, such as
        // `12` or `12.5`.
        number: option<string>,
        // Changes when the chapter's pages change, so the server knows to
        // fetch the page list again. Only a content revision: who released
        // the chapter goes in `release-group`.
        version: option<string>,
        // When the chapter was published, as an RFC 3339 date or date-time.
        published: option<string>,
        // The BCP 47 tag of the language this release is written in, when
        // the source says. Not the series' original language.
        language: option<string>,
        // Who released it, such as a scanlation group or a publisher, as
        // the source names them. Sites often list one chapter several
        // times, once per group; the server groups those releases by
        // `number` and shows one chapter with a choice of releases.
        release-group: option<string>,
        // Whether the series' publisher released it, such as VIZ Media or
        // MANGA Plus. Official releases are picked first when a reader
        // hasn't chosen a group.
        official: bool,
    }

    variant error {
        // The source has no item with this id.
        not-found,
        // A request failed; the text says why.
        network(string),
        // The site answered with something the extension couldn't read.
        parse(string),
        other(string),
    }
}

interface http {
    use types.{header};

    enum method {
        get,
        post,
    }

    record request {
        method: method,
        url: string,
        headers: list<header>,
        body: option<list<u8>>,
        // Seconds the server may answer a GET from its cache. A 2xx
        // response is kept for this long and reused for the same URL and
        // headers, without counting toward the call's requests. Responses
        // over 4 MiB aren't kept, and 30 days is the most.
        cache: option<u32>,
    }

    record response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
        // Whether the response came from the server's cache.
        cached: bool,
    }

    variant http-error {
        // The URL isn't HTTPS or its host isn't one of the manifest's sites.
        not-allowed(string),
        // The response body is larger than the server accepts.
        too-large,
        // This call has made as many requests as it may.
        too-many-requests,
        timeout,
        failed(string),
    }

    // Sends a request and waits for the whole response. Redirects are
    // followed only to allowed sites.
    fetch: func(request: request) -> result<response, http-error>;
}

// Values an extension keeps between calls, such as a token or a parsed
// listing. Keys are the extension's own; values expire after their TTL.
// Each value may be up to 4 MiB, and an extension's values and cached
// responses together up to 128 MiB, past which the oldest are dropped.
interface cache {
    // The value stored under `key`, unless it expired or was dropped.
    get: func(key: string) -> option<list<u8>>;
    // Stores `value` for `ttl` seconds, at most 30 days.
    set: func(key: string, value: list<u8>, ttl: u32) -> result<_, string>;
    delete: func(key: string);
}

// The extension's cookie jar. `http.fetch` already sends it and stores what
// sites set, so most extensions never call this. It's for cookies that
// arrive another way, such as a session an admin pasted in.
interface cookies {
    use types.{header};

    // The cookies a request to `url` would carry, as name and value.
    get: func(url: string) -> list<header>;
    // Stores cookies as if `url` had answered with these `Set-Cookie`
    // values. `url` must be on one of the manifest's sites.
    set: func(url: string, set-cookies: list<string>) -> result<_, string>;
    // Removes every cookie, such as to sign out.
    clear: func();
}

// Loads pages in a real browser, for extensions with the `browser`
// capability. Slow, so most extensions only need `http.fetch`, which already
// gets past challenges on its own; this is for pages that only work with
// scripts running.
interface browser {
    use http.{response, http-error};

    // Loads `url` in the browser and returns the page as rendered, with its
    // cookies kept in the jar. The URL must be on one of the manifest's
    // sites. Counts as a request.
    load: func(url: string) -> result<response, http-error>;
}

// One session per export call. Opening another replaces it. Closing, a
// failure, a trap or the end of the call releases it. Sessions last at most
// 120 seconds, with 128 operations, 30 seconds per operation and 1 MiB results.
// JavaScript runs in the page, never in the worker or server.
interface browser-session {
    open: func(url: string) -> result<_, string>;
    // An expression or async function invocation; returns JSON text.
    evaluate: func(script: string) -> result<string, string>;
    // Coordinates in viewport CSS pixels. These use native browser input.
    click: func(x: u32, y: u32) -> result<_, string>;
    scroll: func(x: u32, y: u32, delta-x: s32, delta-y: s32) -> result<_, string>;
    close: func();
}

// Native raster operations run in an isolated, time-limited worker. Only
// 8-bit JPEG, PNG and WebP inputs, up to 8 MiB and 8 million pixels, are accepted.
interface images {
    // Output is in the input's format: JPEG and WebP at quality 90, PNG
    // lossless. `order[destination]` names the source tile;
    // it must be a permutation of rows * columns, at most 256 tiles.
    // Partial pixels along the right and bottom edges stay in place.
    rearrange: func(body: list<u8>, columns: u32, rows: u32, order: list<u32>) -> result<list<u8>, string>;
}

world source {
    import http;
    import cache;
    import cookies;
    import browser;
    import browser-session;
    import images;
    use types.{manifest, series-page, series, chapter, image, image-data, error, content-rating};
    use http.{response};

    // Called without network access, before anything else.
    export manifest: func() -> manifest;
    // A page of the source's series matching `query`, counting pages from 1.
    // An empty query lists what the source shows first, such as popular series.
    // `content-ratings` are the ratings the reader chose to see, never
    // empty: ask the site for only those where it can filter, and leave out
    // the rest where it can't. The server drops items rated outside them
    // too, but a page the site filtered stays full.
    export search: func(query: string, page: u32, content-ratings: list<content-rating>) -> result<series-page, error>;
    export series: func(id: string) -> result<series, error>;
    // The series' chapters in reading order.
    export chapters: func(series-id: string) -> result<list<chapter>, error>;
    // The chapter's pages in reading order.
    export pages: func(chapter-id: string) -> result<list<image>, error>;
    // Called only for images with transform parameters, after fetching.
    // None preserves the response. Inputs and output are capped at 8 MiB.
    // Must depend only on image, response and this component's code; all
    // additional parameters belong in image.transform, not mutable state.
    export transform-image: func(image: image, response: response) -> result<option<image-data>, error>;
}

// Optional export alongside `source`. Older components need not implement it.
// Every batch runs in a fresh instance with the normal per-call limits.
interface chapter-pagination {
    use types.{chapter, error};
    record batch {
        items: list<chapter>,
        // Opaque continuation for the same series. None means complete.
        next: option<string>,
        // Must remain unchanged throughout one traversal.
        total: u32,
    }
    fetch: func(series-id: string, cursor: option<string>) -> result<batch, error>;
}

world paginated-chapters {
    export chapter-pagination;
}

// Optional export alongside `source`, for sites that list chapters a page at
// a time from either end. With it, a client's page of chapters is one call
// here rather than reading the whole list first. Older components need not
// implement it; the host then pages through the complete list itself.
interface chapter-pages {
    use types.{chapter, error};
    enum chapter-order {
        // Reading order, first chapter first.
        oldest-first,
        newest-first,
    }
    record chapter-page {
        items: list<chapter>,
        // Where the page starts, counted from the end the order names.
        offset: u32,
        // How many chapters the series has, as the site reports it.
        total: u32,
    }
    // Up to `limit` chapters starting at `offset`, or just past chapter
    // `after` when given, counted from the end `order` names. Releases of
    // one chapter must be listed next to each other, as sites that sort by
    // number do, since the server groups them a page at a time. Items are
    // the entries from `offset` on with none left out, so the next page
    // starts at `offset` plus their count; fewer than `limit` is fine. Return
    // `not-found` for an `after` the site can't place without reading
    // everything; the host then finds it in the complete list.
    page: func(series-id: string, order: chapter-order, offset: u32, limit: u32, after: option<string>) -> result<chapter-page, error>;
}

world paged-chapters {
    export chapter-pages;
}

// Optional export alongside `source`, for sources whose chapters are books
// or other files rather than pages of images, such as a novel as an EPUB or
// a paper as a PDF. Older components need not implement it; the host then
// reads every chapter as pages through `pages`.
interface chapter-content {
    use types.{header, image, error};

    // How a chapter is read. The server tells clients which, so they pick
    // a reader without guessing from URLs.
    enum content-format {
        // Pages of images, read like a comic.
        images,
        // An EPUB 2 or 3 publication, served as `application/epub+zip`.
        epub,
        // A PDF document, served as `application/pdf`.
        pdf,
    }

    // A file the server downloads itself, such as a book. The server sends
    // the headers as given and checks the URL against the manifest's sites
    // like any other request, and checks the file is the format named.
    record asset {
        // The source's own id for this file, the same on every call, such
        // as `1342.epub3.images`. A different file gets a different id, so
        // clients and the server may keep a download under it.
        id: string,
        // `epub` or `pdf`; one the source's `formats` lists.
        format: content-format,
        url: string,
        headers: list<header>,
        // The file's size in bytes, when the source knows.
        size: option<u64>,
        // A name to save it under, such as `pride-and-prejudice.epub`.
        file-name: option<string>,
    }

    // The terms an openly licensed publication is shared under, passed to
    // readers with the chapter so they see who to credit and where it came
    // from. Leave out what the source doesn't say.
    record rights {
        // An SPDX identifier, such as `CC-BY-4.0`, or the license's name as
        // the source gives it, such as `Public domain in the USA`.
        license: option<string>,
        // An HTTPS link to the license's text.
        license-url: option<string>,
        // The credit the license asks for, as the source words it.
        attribution: option<string>,
        // An HTTPS link to the publication's own page on the source.
        source-url: option<string>,
    }

    variant content {
        // The chapter's pages in reading order, as `pages` returns them.
        // The source's `formats` must list `images`.
        pages(list<image>),
        // The chapter as one file.
        file(asset),
    }

    record reading {
        content: content,
        rights: option<rights>,
    }

    // The formats this source's chapters come in, never empty. Called
    // without network access, like `manifest`; the repository's index must
    // list the same.
    formats: func() -> list<content-format>;
    // How to read the chapter. Keep `pages` answering for chapters that are
    // pages, for hosts that don't call this; for a file it may return
    // `other` saying the chapter is a file.
    read: func(chapter-id: string) -> result<reading, error>;
}

world chapter-contents {
    export chapter-content;
}
