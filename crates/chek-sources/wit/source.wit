// The contract between the Chek server and a source extension.
//
// An extension is a WebAssembly component that targets the `source` world. It
// runs with an empty WASI environment: no files, no environment variables, no
// sockets and no clock beyond what WASI always gives. The only way out is the
// `http` interface, and the server lets it reach only the sites the
// extension's manifest declares.
//
// Every call starts from a fresh instance, so memory doesn't carry over
// between calls. What should carry over goes through the server instead:
// `cache` keeps values, a request can ask for its response to be cached, and
// `cookies` holds a jar the server sends and fills on every request, as a
// browser would. All three are kept per extension id and sites, across
// versions and restarts, and none is available while the manifest is read.
package chek:source@0.2.0;

interface types {
    type header = tuple<string, string>;

    // An image the server fetches itself, such as a cover or a page. The
    // server sends the headers as given and checks the URL against the
    // manifest's sites like any other request.
    record image {
        url: string,
        headers: list<header>,
    }

    enum reading-direction {
        ltr,
        rtl,
        ttb,
    }

    record manifest {
        // Stable and unique across repositories, in reverse-DNS form such
        // as `org.example.comics`.
        id: string,
        name: string,
        version: string,
        // Hosts the extension may reach, such as `api.example.org`, or
        // `*.example.org` for any subdomain of example.org. Requests use
        // HTTPS only.
        sites: list<string>,
        // BCP 47 tags of the languages the source serves, empty if any.
        languages: list<string>,
        // What the extension needs beyond plain requests. The repository's
        // index must list the same.
        capabilities: list<capability>,
    }

    enum capability {
        // A real browser, through the solver service the server's admin
        // runs. Requests that meet a Cloudflare challenge are passed to it
        // and retried with the cookies and user agent it earned, and the
        // `browser` interface loads pages in it directly. Without a
        // solver, challenges come back as the site sent them.
        browser,
    }

    record series-item {
        // The source's own id, stored as the series' remote id.
        id: string,
        title: string,
        cover: option<image>,
    }

    record series-page {
        items: list<series-item>,
        has-more: bool,
    }

    record contributor {
        name: string,
        // A Readium contributor role, such as `author` or `artist`.
        role: string,
    }

    record series {
        id: string,
        title: string,
        summary: option<string>,
        cover: option<image>,
        contributors: list<contributor>,
        reading-direction: option<reading-direction>,
    }

    record chapter {
        // The source's own id, stored as the content's remote id.
        id: string,
        title: string,
        // The chapter or volume number as the source writes it, such as
        // `12` or `12.5`.
        number: option<string>,
        // Changes when the chapter's pages change, so the server knows to
        // fetch the page list again.
        version: option<string>,
        // When the chapter was published, as an RFC 3339 date or date-time.
        published: option<string>,
    }

    variant error {
        // The source has no item with this id.
        not-found,
        // A request failed; the text says why.
        network(string),
        // The site answered with something the extension couldn't read.
        parse(string),
        other(string),
    }
}

interface http {
    use types.{header};

    enum method {
        get,
        post,
    }

    record request {
        method: method,
        url: string,
        headers: list<header>,
        body: option<list<u8>>,
        // Seconds the server may answer a GET from its cache. A 2xx
        // response is kept for this long and reused for the same URL and
        // headers, without counting toward the call's requests. Responses
        // over 4 MiB aren't kept, and 30 days is the most.
        cache: option<u32>,
    }

    record response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
        // Whether the response came from the server's cache.
        cached: bool,
    }

    variant http-error {
        // The URL isn't HTTPS or its host isn't one of the manifest's sites.
        not-allowed(string),
        // The response body is larger than the server accepts.
        too-large,
        // This call has made as many requests as it may.
        too-many-requests,
        timeout,
        failed(string),
    }

    // Sends a request and waits for the whole response. Redirects are
    // followed only to allowed sites.
    fetch: func(request: request) -> result<response, http-error>;
}

// Values an extension keeps between calls, such as a token or a parsed
// listing. Keys are the extension's own; values expire after their TTL.
// Each value may be up to 4 MiB, and an extension's values and cached
// responses together up to 128 MiB, past which the oldest are dropped.
interface cache {
    // The value stored under `key`, unless it expired or was dropped.
    get: func(key: string) -> option<list<u8>>;
    // Stores `value` for `ttl` seconds, at most 30 days.
    set: func(key: string, value: list<u8>, ttl: u32) -> result<_, string>;
    delete: func(key: string);
}

// The extension's cookie jar. `http.fetch` already sends it and stores what
// sites set, so most extensions never call this. It's for cookies that
// arrive another way, such as a session an admin pasted in.
interface cookies {
    use types.{header};

    // The cookies a request to `url` would carry, as name and value.
    get: func(url: string) -> list<header>;
    // Stores cookies as if `url` had answered with these `Set-Cookie`
    // values. `url` must be on one of the manifest's sites.
    set: func(url: string, set-cookies: list<string>) -> result<_, string>;
    // Removes every cookie, such as to sign out.
    clear: func();
}

// Loads pages in a real browser, for extensions with the `browser`
// capability. Slow, so most extensions only need `http.fetch`, which already
// gets past challenges on its own; this is for pages that only work with
// scripts running.
interface browser {
    use http.{response, http-error};

    // Loads `url` in the browser and returns the page as rendered, with its
    // cookies kept in the jar. The URL must be on one of the manifest's
    // sites. Counts as a request.
    load: func(url: string) -> result<response, http-error>;
}

world source {
    import http;
    import cache;
    import cookies;
    import browser;
    use types.{manifest, series-page, series, chapter, image, error};

    // Called without network access, before anything else.
    export manifest: func() -> manifest;
    // A page of the source's series matching `query`, counting pages from 1.
    // An empty query lists what the source shows first, such as popular series.
    export search: func(query: string, page: u32) -> result<series-page, error>;
    export series: func(id: string) -> result<series, error>;
    // The series' chapters in reading order.
    export chapters: func(series-id: string) -> result<list<chapter>, error>;
    // The chapter's pages in reading order.
    export pages: func(chapter-id: string) -> result<list<image>, error>;
}
