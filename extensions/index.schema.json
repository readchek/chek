{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chek.page/extensions/index.schema.json",
  "title": "Chek extension repository index",
  "description": "Version 1 of a repository's index.json. See docs/extension-repositories.md.",
  "type": "object",
  "required": ["extensions"],
  "properties": {
    "spec": {
      "description": "The format version; 1 when absent.",
      "type": "integer",
      "const": 1
    },
    "name": {
      "description": "What the repository calls itself.",
      "type": "string",
      "maxLength": 200
    },
    "extensions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "file", "sha256"],
        "properties": {
          "id": {
            "description": "Reverse-DNS id, matching the component's manifest.",
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "version": { "type": "string", "minLength": 1, "maxLength": 200 },
          "file": {
            "description": "The component's URL, relative to the index.",
            "type": "string"
          },
          "sha256": {
            "description": "The component's SHA-256 digest in lowercase hex.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sites": { "type": "array", "items": { "type": "string" } },
          "languages": { "type": "array", "items": { "type": "string" } },
          "capabilities": {
            "description": "What the extension needs beyond plain requests, such as browser.",
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
