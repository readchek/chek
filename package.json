{
  "name": "chek",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @chek/api dev",
    "start": "bun run --filter @chek/api start",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:website": "bun run --filter @chek/website dev",
    "build:website": "bun run --filter @chek/website build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "effect": "^4.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.2"
}
