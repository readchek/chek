{
  "name": "chek",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "corpus:setup": "bun scripts/corpus.ts",
    "corpus:verify": "bun scripts/corpus.ts --verify",
    "dev": "bun run --filter @chek/api dev",
    "start": "bun run --filter @chek/api start",
    "build:packages": "bun run --filter @chek/core build && bun run --filter @chek/extensions build",
    "typecheck": "bun run build:packages && bun run --workspaces typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:website": "bun run --filter @chek/website dev",
    "build:website": "bun run --filter @chek/website build",
    "deploy:website": "bun run --filter @chek/website deploy"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.0.0",
    "@types/bun": "latest",
    "effect": "^4.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.3"
}
