{
  "name": "chek",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun run --workspaces typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:website": "bun run --filter @chek/website dev",
    "build:website": "bun run --filter @chek/website build",
    "deploy:website": "bun run --filter @chek/website deploy"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.3"
}
