HOST=127.0.0.1
PORT=8080
LOG_LEVEL=Info
LOG_FORMAT=pretty
CHEK_DATA_DIR=.chek
# Optional folder containing explicitly trusted extension directories.
CHEK_EXTENSIONS_DIR=
# Already-installed npm packages exporting ./extension.json, separated by commas.
CHEK_EXTENSION_PACKAGES=
# Optional directory of author collection JSON catalogs; does not install code.
CHEK_EXTENSION_COLLECTIONS_DIR=
# Required when HOST is not loopback. Use a long random value.
CHEK_API_TOKEN=
CHEK_MAX_ASSET_BYTES=2000000000
CHEK_EXTENSION_TIMEOUT_MS=3600000
CHEK_ASSET_TIMEOUT_MS=120000
CHEK_IMPORT_CONCURRENCY=2

# Jarvis test collector; requires Tailscale. This is the collector, not the UI.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jarvis:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=chek-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=test

# Set either exporter to none to disable that signal.
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000
# Disable all telemetry export without disabling console logs.
OTEL_SDK_DISABLED=false

# Batch export intervals, in milliseconds.
OTEL_BLRP_SCHEDULE_DELAY=1000
OTEL_BSP_SCHEDULE_DELAY=1000

# Optional overrides: use full signal URLs, including /v1/logs or /v1/traces.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://jarvis:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jarvis:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=key=value
